{
  "name": "dsh-tool-subtitle",
  "version": "1.0.0",
  "description": "Subtitle toolkit for DeepSeek Harness: transcribe audio to timed cues, convert between SRT/VTT/ASS, and shift, merge or validate a timeline.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "subtitle",
    "srt",
    "vtt",
    "ass",
    "transcript",
    "captions",
    "whisper"
  ],
  "author": "yuehancn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuehancn/dsh-tool-subtitle.git"
  },
  "homepage": "https://github.com/yuehancn/dsh-tool-subtitle#readme",
  "bugs": {
    "url": "https://github.com/yuehancn/dsh-tool-subtitle/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}